# ローカルの設定。このファイルを .env.local にコピーして値を書き換える（.env.local はコミットしない）。

# npm run deploy のコピー先：実運用の Vault のプラグインフォルダ。
# フォルダ名は manifest.json の id と同じにすること。
OBSIDIAN_PLUGIN_DIR=/path/to/your/vault/.obsidian/plugins/study-curve

# npm run dev のコピー先：確認用の Vault のプラグインフォルダ（任意）。
# 実運用の Vault を指定しないこと。
OBSIDIAN_DEV_PLUGIN_DIR=/path/to/test/vault/.obsidian/plugins/study-curve

# npm run qa:vault -- --push の push 先：確認用の Vault の非公開リポジトリ（#16）。
QA_VAULT_REMOTE=git@github.com:<ユーザー名>/study-curve-qa-vault.git
